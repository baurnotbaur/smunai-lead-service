# Скопируйте в .env и поменяйте значения

# Порт HTTP-сервера
PORT=4000

# Публичный адрес сервиса — используется в сниппетах подключения сайта
PUBLIC_URL=http://localhost:4000

# Секрет для подписи сессий. ОБЯЗАТЕЛЬНО поменяйте на проде (любая длинная случайная строка)
SESSION_SECRET=change-me-to-a-long-random-string

# Учётка администратора, создаётся при первом запуске
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=admin12345

# Путь к файлу базы (SQLite). Используется, когда не задан TURSO_DATABASE_URL
DB_PATH=./data/leads.db

# Сетевая база Turso — нужна там, где нет своего диска (Vercel и прочие функции).
# Это та же SQLite, только на их сервере; заполните оба поля или оставьте пустыми.
# Адрес и токен: turso.tech -> база -> Connect
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Уведомления о новых заявках в Telegram (необязательно)
# Бот: @BotFather -> /newbot; chat_id: напишите боту и откройте
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp и Instagram --------------------------------------------------
# Оба канала идут через Meta и приходят на один вебхук:
#   <PUBLIC_URL>/api/v1/webhook/meta
#
# META_VERIFY_TOKEN — строка, которую вы придумываете сами и вписываете
# и сюда, и в поле «Verify token» при подключении вебхука в Meta.
META_VERIFY_TOKEN=
# META_APP_SECRET — App Secret приложения (Settings -> Basic). Им подписан
# каждый запрос; без него вебхук отклоняет всё, потому что адрес публичный.
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# WhatsApp Business: WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Instagram: токен страницы Facebook, связанной с аккаунтом
INSTAGRAM_TOKEN=

# Автоответ в переписке. Выключите, если с клиентами общаются только руками
BOT_ENABLED=1

# Ответы бота через Gemini. Без ключа бот остаётся сценарным: здоровается,
# просит телефон и зовёт менеджера — но ничего не выдумывает в обоих случаях.
# Ключ: aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Модель. По умолчанию lite: отвечает за секунду-две, старшие думают 15-25 секунд
BOT_MODEL=gemini-3.5-flash-lite
# Сколько ждём модель, потом отвечаем сценарной фразой
BOT_TIMEOUT_MS=12000

# Ставить куки только по HTTPS (включите, когда повесите домен с SSL)
SECURE_COOKIES=0
