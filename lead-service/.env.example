# Скопируйте в .env и поменяйте значения

# Порт HTTP-сервера
PORT=4000

# Публичный адрес сервиса — используется в сниппетах подключения сайта
PUBLIC_URL=http://localhost:4000

# Секрет для подписи сессий. ОБЯЗАТЕЛЬНО поменяйте на проде (любая длинная случайная строка)
SESSION_SECRET=change-me-to-a-long-random-string

# Учётка администратора, создаётся при первом запуске
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=admin12345

# Путь к файлу базы (SQLite). Используется, когда не задан TURSO_DATABASE_URL
DB_PATH=./data/leads.db

# Сетевая база Turso — нужна там, где нет своего диска (Vercel и прочие функции).
# Это та же SQLite, только на их сервере; заполните оба поля или оставьте пустыми.
# Адрес и токен: turso.tech -> база -> Connect
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Уведомления о новых заявках в Telegram (необязательно)
# Бот: @BotFather -> /newbot; chat_id: напишите боту и откройте
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ставить куки только по HTTPS (включите, когда повесите домен с SSL)
SECURE_COOKIES=0
